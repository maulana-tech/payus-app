NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

DATABASE_URL=postgres://localhost:5432/payus
CRON_SECRET=replace-with-a-long-random-secret

# Email notifications (Resend). Leave empty to run without email notifications.
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=

# PayPal (sandbox credentials from developer.paypal.com → Apps & Credentials).
# NEXT_PUBLIC_PAYPAL_CLIENT_ID is the same client id; the payer's browser
# loads the JS SDK with it.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Set to "true" once Payouts is approved on the PayPal account. Until then a
# release is recorded as `payout.simulated` and labelled as such in the app.
PAYPAL_PAYOUTS_ENABLED=

# The agents. Without either route below, the rail still works and the
# agents are off and say so.
#
# Route 1 — the first-party Claude API:
ANTHROPIC_API_KEY=
#
# Route 2 — Amazon Bedrock. Set the backend and a region; credentials come
# from the ordinary AWS chain (env vars, AWS_PROFILE, or an IAM role, which
# needs no variable at all). A Bedrock API key works too, as
# AWS_BEARER_TOKEN_BEDROCK.
ANTHROPIC_BACKEND=
BEDROCK_AWS_REGION=
# Only outside us-east-1: the inference profile to call, because the
# Messages endpoint serves bare ids from us-east-1 only. Sydney, say:
#   BEDROCK_MODEL_ID=au.anthropic.claude-opus-5-5
BEDROCK_MODEL_ID=
